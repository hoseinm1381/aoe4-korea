                    xmlns:esControls="clr-namespace:WPFGUI.Shared.Controls;assembly=EngineUI" xmlns:esUtility="clr-namespace:WPFGUI.Shared.Utility;assembly=EngineUI"
                    xmlns:gameStatsModelTypes="clr-namespace:GameStatsModelTypes" xmlns:hudModelTypes="clr-namespace:HUDModelTypes"
                    xmlns:local="clr-namespace:WPFGUI.HUD.Controls" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:models="clr-namespace:WPFGUI.Shared.Models;assembly=EngineUI" xmlns:pages="clr-namespace:WPFGUI.HUD.Pages"
                    xmlns:races="clr-namespace:RaceSelectorModelTypes" xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:wm="clr-namespace:WPFGUI.Shared.MarkupExtensions;assembly=EngineUI" xmlns:ww="clr-namespace:WPFGUI"
                    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="..\..\Resources\HUDResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <GridLength x:Key="HUDTooltipIconColumnWidth">80</GridLength>
    <Thickness x:Key="HUDTooltipPanelPadding">20</Thickness>
    <Thickness x:Key="HUDTextElementVerticalSpacing">0,18,0,0</Thickness>
    <sys:Double x:Key="HUDIssuableTooltipMaxWidth">850</sys:Double>
    <sys:Double x:Key="HUDTooltipContentColumnMaxWidth">350</sys:Double>
    <GridLength x:Key="HUDTooltipContentColumnFixedWidth">350</GridLength>

    <Style x:Key="DistrictIconProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="43" />
        <Setter Property="Maximum" Value="1" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/WPFGUI;component/icons/districts/district_icon_fill.png" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid MinWidth="{TemplateBinding MinHeight}" MinHeight="{TemplateBinding MinHeight}">
                        <Border x:Name="PART_Track" Background="Transparent" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Background}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="{StaticResource HUDTooltipIconSize}" />
    </Style>
    <Style x:Key="HouseOfWisdomDistrictIconProgressBarStyle"
           BasedOn="{StaticResource DistrictIconProgressBarStyle}"
           TargetType="{x:Type ProgressBar}">
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="pack://application:,,,/WPFGUI;component/icons/races/abbasid/golden_age/golden_age_icon_fill.png" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CombatEfficiencyRatingItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TertiaryColorLightBrush}" />
        <Setter Property="Height" Value="27" />
        <Setter Property="Margin" Value="{StaticResource ExtraSmallMarginTop}" />
        <Setter Property="Padding" Value="{StaticResource ExtraSmallMarginAll}" />
    </Style>

    <Style x:Key="TooltipArrowRightImage"
           BasedOn="{StaticResource {x:Type Image}}"
           TargetType="Image">
        <Setter Property="Margin" Value="{StaticResource SmallMarginLeftRight}" />
        <Setter Property="Source" Value="pack://application:,,,/WPFGUI;component/icons/tooltip_arrow_right.png" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="15" />
    </Style>

    <Style x:Key="TooltipArrowLeftImage" TargetType="Image">
        <Setter Property="Margin" Value="{StaticResource SmallMarginLeftRight}" />
        <Setter Property="Source" Value="pack://application:,,,/WPFGUI;component/icons/tooltip_arrow_left.png" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="15" />
    </Style>

    <Style x:Key="DefaultTooltipIconBackground" TargetType="Rectangle">
        <Setter Property="Fill">
            <Setter.Value>
                <SolidColorBrush Color="{DynamicResource ButtonBgAbilityColor}" />
            </Setter.Value>
        </Setter>
        <Setter Property="RadiusX" Value="{StaticResource HUDButtonRadiusX}" />
        <Setter Property="RadiusY" Value="{StaticResource HUDButtonRadiusY}" />
    </Style>

    <DataTemplate x:Key="GoldenAgeDataTemplate" DataType="{x:Type hudModelTypes:IssuableModel}">
        <ContentControl MaxWidth="{StaticResource HUDTooltipMaxWidthMedium}" Style="{StaticResource HUDTooltipBorderStyle}">
            <Grid d:DataContext="{x:Static local:IssuableToolTip.Model}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!--  command card icon  -->
                <Grid Grid.Column="0"
                      Width="{StaticResource HUDCommandCardBuildMenuIconSize}"
                      Height="{StaticResource HUDCommandCardBuildMenuIconSize}"
                      Margin="{StaticResource SmallMarginRight}"
                      VerticalAlignment="Top">
                    <Image Source="pack://application:,,,/WPFGUI;component/icons/races/abbasid/golden_age/golden_age_icon.png" />
                    <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style BasedOn="{StaticResource HUDPrimaryColorLightTitleTextBlock27ptStyle}" TargetType="{x:Type TextBlock}">
                                <Setter Property="Text" Value="{Binding DataContext.LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.CurrentTier, RelativeSource={RelativeSource AncestorType={x:Type pages:CardinalHUDPage}}, FallbackValue=0}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CasterEntity, Converter={StaticResource NotNullConverter}}" Value="True">
                                        <Setter Property="Text" Value="{Binding CasterEntity.DistrictInfo.CurrentTier}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="1"
                            Margin="{StaticResource SmallMarginTop}"
                            Orientation="Vertical">
                    <Grid>
                        <!--  Title  -->
                        <TextBlock Style="{StaticResource nHUDSubheaderSmallTextBlockStyle}" Text="{Binding Properties.UIInfo.Name, FallbackValue={esUtility:LocString $11183531}}" />

                        <!--  Structure Count  -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource nHUDBaseHeavyTextBlockStyle}" TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text">
                                            <Setter.Value>
                                                <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11191811">
                                                    <Binding Mode="OneWay" Path="DataContext.LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.CurrentDP"
                                                             RelativeSource="{RelativeSource AncestorType={x:Type pages:CardinalHUDPage}}" />
                                                    <Binding Mode="OneWay" Path="DataContext.LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.UnlockNextTierDP"
                                                             RelativeSource="{RelativeSource AncestorType={x:Type pages:CardinalHUDPage}}" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CasterEntity, Converter={StaticResource NotNullConverter}}" Value="True">
                                                <Setter Property="Text">
                                                    <Setter.Value>
                                                        <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11191811">
                                                            <Binding Mode="OneWay" Path="CasterEntity.DistrictInfo.CurrentDP" />
                                                            <Binding Mode="OneWay" Path="CasterEntity.DistrictInfo.UnlockNextTierDP" />
                                                        </MultiBinding>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Width="14"
                                   Margin="{StaticResource ExtraSmallMarginLeft}"
                                   VerticalAlignment="Center"
                                   Source="pack://application:,,,/WPFGUI;component/icons/districts/district_points.png" />
                        </StackPanel>
                    </Grid>

                    <!--  Description  -->
                    <TextBlock Margin="{StaticResource MediumMarginBottom}"
                               Style="{StaticResource nHUDBodyTextBlockStyle}"
                               Text="{Binding Properties.UIInfo.Help, FallbackValue={esUtility:LocString $11191805}}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  Tiers  -->
                <ItemsControl Grid.Row="1" Grid.Column="1">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.LocalPlayer.AbbasidHouseOfWisdomEntity.DistrictInfo.Tiers, RelativeSource={RelativeSource AncestorType={x:Type pages:CardinalHUDPage}}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CasterEntity, Converter={StaticResource NotNullConverter}}" Value="True">
                                    <Setter Property="ItemsSource" Value="{Binding CasterEntity.DistrictInfo.Tiers}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{StaticResource SmallMarginBottom}" Visibility="{Binding Visibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Width="{StaticResource HUDTooltipSmallIconSize}"
                                       Height="{StaticResource HUDTooltipSmallIconSize}"
                                       Margin="-36,-6,0,0" VerticalAlignment="Top">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Setter Property="Source" Value="pack://application:,,,/WPFGUI;component/icons/districts/districts_unlocked.png" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter Property="Source" Value="pack://application:,,,/WPFGUI;component/icons/districts/districts_locked.png" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <StackPanel Grid.Column="1" Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock VerticalAlignment="Center"
                                                   Style="{StaticResource nHUDTitleAltTextBlockStyle}"
                                                   Text="{Binding Tier, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11192005}" />
                                        <Image Width="14"
                                               Margin="{StaticResource ExtraSmallMarginLeft}"
                                               VerticalAlignment="Center"
                                               Source="pack://application:,,,/WPFGUI;component/icons/districts/district_points.png" />
                                        <TextBlock Margin="{StaticResource ExtraSmallMarginLeft}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource nHUDBaseTextBlockStyle}"
                                                   Text="{Binding UnlockDP, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11203682}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource nHUDBodyTextBlockStyle}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ContentControl>
    </DataTemplate>

