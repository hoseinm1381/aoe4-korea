    <DataTemplate x:Key="SultanateScholarsText" DataType="{x:Type hudModelTypes:IssuableModel}">
        <TextBlock Name="ScholarsText"
                   Margin="0,4,0,0"
                   Style="{StaticResource nHUDBodyTextBlockStyle}"
                   TextWrapping="Wrap" Visibility="Collapsed">
            <TextBlock.Text>
                <Binding Converter="{StaticResource LocalizedStringConverter}"
                         ConverterParameter="$11167296" Path="CasterEntity.StateModel.Int[scholars_working_sul]" />
            </TextBlock.Text>
        </TextBlock>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Player.RaceID}" Value="{StaticResource SultanateRaceID}">
                <Setter TargetName="ScholarsText" Property="Visibility">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                            <Binding Path="Available" />
                            <Binding Path="IsUpgrade" />
                            <Binding Converter="{StaticResource NotNullOrEmptyString}" Path="TooltipDataTemplate" />
                            <Binding Converter="{StaticResource GreaterCompare}"
                                     ConverterParameter="0" Path="CasterEntity.StateModel.Int[scholars_working_sul]" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="DefaultIssuableTooltipDataTemplate"
           BasedOn="{StaticResource HUDTooltipBorderStyle}"
           TargetType="ContentControl">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type hudModelTypes:IssuableModel}">
                    <Grid d:DataContext="{x:Static local:IssuableToolTip.Model}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                            <ColumnDefinition Width="{StaticResource HUDTooltipContentColumnFixedWidth}" />
                            <ColumnDefinition>
                                <ColumnDefinition.Style>
                                    <Style TargetType="ColumnDefinition">
                                        <Setter Property="Width" Value="0" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsUpgrade}" Value="False" />
                                                    <Condition Binding="{Binding Related.Count, Converter={StaticResource GreaterCompare}, ConverterParameter=0}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Width" Value="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ColumnDefinition.Style>
                            </ColumnDefinition>
                            <ColumnDefinition MaxWidth="{StaticResource HUDTooltipContentColumnMaxWidth}" />
                        </Grid.ColumnDefinitions>

                        <!--  Command card icon  -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                            <ContentPresenter Height="{StaticResource HUDTooltipIconSize}"
                                              MinWidth="{StaticResource HUDTooltipIconSize}"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Content="{Binding}"
                                              ContentTemplate="{StaticResource IssuableIconPresenter}" />

                            <!--  resources  -->
                            <ItemsControl Margin="0,10,0,0" VerticalAlignment="Top"
                                          ItemsSource="{Binding Resources}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type hudModelTypes:IssuableResourceModel}">
                                        <StackPanel Margin="{StaticResource ExtraSmallMarginBottom}" Orientation="Horizontal">
                                            <Image Width="26" Height="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Stretch="UniformToFill">
                                                <Image.Style>
                                                    <Style BasedOn="{StaticResource {x:Type Image}}" TargetType="{x:Type Image}">
                                                        <Setter Property="Source" Value="{Binding Icon}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInsufficient}" Value="True">
                                                                <Setter Property="Source" Value="{Binding InsufficientIcon}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Text="{Binding Amount, Converter={StaticResource CastToIntOperator}}">
                                                <TextBlock.Style>
                                                    <Style BasedOn="{StaticResource nHUDBaseHeavyTextBlockStyle}" TargetType="{x:Type TextBlock}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInsufficient}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorColorLightBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="3,0,0,4"
                                        Orientation="Horizontal"
                                        Visibility="{Binding ProductionTimeTotal, Converter={StaticResource InequalityCompare}, ConverterParameter=0}">
                                <Image Width="16" Height="16"
                                       Margin="2,0,2,0" VerticalAlignment="Center"
                                       Source="/WPFGUI;component/icons/shared/elapsed_time_icon.png" />
                                <!--  ProductionTimeTotal  -->
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                           Text="{Binding ProductionTimeTotal, Converter={StaticResource TimeFormat}}"
                                           Visibility="{Binding ProductionTimeTotal, Converter={StaticResource NumberToVis}}" />
                                <!--  infinity symbol: visible if ProductionTimeTotal < 0  -->
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                           Text="{esUtility:LocString $11168149}"
                                           Visibility="{Binding ProductionTimeTotal, Converter={StaticResource LessCompare}, ConverterParameter=0}" />
                            </StackPanel>

                            <!--  Build Limit  -->

                            <StackPanel Orientation="Horizontal" Visibility="{Binding Properties.HasBuildLimit, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                <Image Width="26" Height="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Source="../../icons/common/build_limit.png" Stretch="UniformToFill" />
                                <TextBlock Margin="5,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource nHUDBaseHeavyTextBlockStyle}" TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Properties.BuildLimitReached}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorColorLightBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11004775">
                                            <Binding Path="Properties.Completions" />
                                            <Binding Path="Properties.BuildLimit" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>


                            <!--  Population Cost  -->
                            <Grid Margin="6,0,0,4" Visibility="{Binding Population.Population, Converter={StaticResource GreaterCompare}, ConverterParameter=1, FallbackValue=Collapsed}">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSufficientPopulation, Converter={StaticResource BoolToVis}}">
                                    <Image Width="20" Height="23"
                                           VerticalAlignment="Center"
                                           Source="/WPFGUI;component/icons/resources/resource_popcap.png" />
                                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                               Text="{Binding Population.Population, Converter={StaticResource CastToIntOperator}}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSufficientPopulation, Converter={StaticResource InvBoolToVis}}">
                                    <Image Height="{StaticResource HUDResourceIconSize}"
                                           VerticalAlignment="Center"
                                           Source="/WPFGUI;component/icons/resources/resource_popcap_reached.png" />
                                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource nHUDBaseHeavyErrorTextBlockStyle}"
                                               Text="{Binding Population.Population, Converter={StaticResource CastToIntOperator}}" />
                                </StackPanel>
                            </Grid>

                            <!--  Ability on cooldown  -->
                            <StackPanel Margin="3,0,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding RechargingVisibility, FallbackValue=Collapsed}">
                                <Image Width="20" Height="20"
                                       VerticalAlignment="Center"
                                       Source="/WPFGUI;component/icons/shared/elapsed_time_icon.png" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                           Text="{Binding RechargeSecondsRemaining}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Main description area  -->
                        <StackPanel Grid.Column="2"
                                    Margin="0,-5,0,0"
                                    Orientation="Vertical">
                            <StackPanel>
                                <!--  title text  -->
                                <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                    <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding Properties.UIInfo.Name}" />
                                </esControls:Marquee>

                                <!--  label  -->
                                <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IssuableLabelPresenter}" />
                                </esControls:Marquee>

                                <!--  Unique to civ  -->
                                <Grid Margin="{StaticResource SmallMarginTop}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.Visibility>
                                        <MultiBinding Converter="{StaticResource MultiLogicalOr}">
                                            <Binding Path="Properties.UIInfo.IsUniqueToRace" />
                                            <Binding Converter="{StaticResource IsEqualConverter}"
                                                     ConverterParameter="UniqueBuildingUpgradeDataTemplate" Path="TooltipDataTemplate" />
                                        </MultiBinding>
                                    </Grid.Visibility>

                                    <Image HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Style="{StaticResource UniqueToCivIcon}" />
                                    <esControls:Marquee Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Speed="60">
                                        <!--  $11164295: Unique to %1RACE_NAME%  -->
                                        <TextBlock VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource nHUDBodyTextBlockStyle}" TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Player.RaceName, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11164295}" />
                                                    <Style.Triggers>
                                                        <!--  This is for the Codex  -->
                                                        <DataTrigger Binding="{Binding Player}" Value="{x:Null}">
                                                            <Setter Property="Text" Value="{Binding SelectedRace.Name, Source={x:Static races:RaceSelectorModel.Instance}, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11164295}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </esControls:Marquee>
                                </Grid>

                                <!--  description  -->
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource nHUDBodyTextBlockStyle}"
                                           Text="{Binding Properties.UIInfo.Help}"
                                           TextWrapping="Wrap" />

                                <!--  Negative description  -->
                                <TextBlock Margin="0,18,0,0"
                                           Style="{StaticResource nHUDBaseHeavyErrorTextBlockStyle}"
                                           Text="{Binding Properties.UIInfo.Brief}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Margin="{StaticResource SmallMarginTopBottom}">
                                <!--  district point  -->
                                <Grid Margin="{StaticResource SmallMarginBottom}" Visibility="{Binding Properties.DistrictPoint, Converter={StaticResource NumberToVis}, FallbackValue=Collapsed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Padding="4,2" VerticalAlignment="Center"
                                            BorderBrush="{DynamicResource PrimaryColorDarkBrush}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       Style="{StaticResource nHUDBaseAccentTextBlockStyle}"
                                                       Text="{Binding Properties.DistrictPoint, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11168862}" />
                                            <Image Width="14"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Source="pack://application:,,,/WPFGUI;component/icons/districts/district_points.png" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Margin="{StaticResource SmallMarginLeft}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style BasedOn="{StaticResource nHUDBaseAccentTextBlockStyle}" TargetType="{x:Type TextBlock}">
                                                <Setter Property="Text" Value="{esUtility:LocString $11168150}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Player.RaceID, Converter={StaticResource IsEqualConverter}, ConverterParameter={StaticResource ScotsRaceID}}" Value="True">
                                                        <Setter Property="Text" Value="{esUtility:LocString $11274748}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!--  error message  -->
                                <TextBlock Margin="{StaticResource ExtraSmallMarginTopBottom}"
                                           Style="{StaticResource nHUDBaseHeavyErrorTextBlockStyle}"
                                           Text="{Binding ReasonUnavailable}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding IsAcquiredUpgrade, Converter={StaticResource InvBoolToVis}}" />

                                <!--  insufficient population  -->
                                <TextBlock Margin="{StaticResource ExtraSmallMarginTopBottom}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style BasedOn="{StaticResource nHUDBaseHeavyErrorTextBlockStyle}" TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!--  Cannot produce %1NAME%. Build more Houses!  -->
                                                <DataTrigger Binding="{Binding Path=AtMaxPopulationCap}" Value="False">
                                                    <Setter Property="Text" Value="{Binding Properties.UIInfo.Name, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11183126}" />
                                                </DataTrigger>
                                                <!--  Cannot produce %1NAME%. Maximum population capacity reached.  -->
                                                <DataTrigger Binding="{Binding Path=AtMaxPopulationCap}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Properties.UIInfo.Name, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11197742}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource MultiLogicalAnd}">
                                            <Binding Converter="{StaticResource NullOrEmptyString}" Path="ReasonUnavailable" />
                                            <Binding Converter="{StaticResource InvBool}" Path="HasSufficientPopulation" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <!--  extra infos and influence  -->
                                <ItemsControl Margin="{StaticResource SmallMarginTop}" ItemsSource="{Binding Properties.ExtraInfos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Grid.Column="0"
                                                           Width="{StaticResource HUDResourceIconSize}"
                                                           Margin="-1,0,0,0" HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"
                                                           Source="{Binding Icon}" />
                                                    <TextBlock Margin="6,1,6,0"
                                                               Style="{StaticResource nHUDSubtitleAltTextBlockStyle}"
                                                               Text="{esUtility:LocString $11148519}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                           Text="{Binding Description}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  Scholars text  -->
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SultanateScholarsText}" />
                            </StackPanel>
                        </StackPanel>

                        <!--  Units this building can produce  -->
                        <ItemsControl Grid.Column="4"
                                      ItemsSource="{Binding Related}"
                                      Visibility="{Binding IsUpgrade, Converter={StaticResource InvBoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type hudModelTypes:UIInfoModel}">
                                    <DockPanel Margin="{StaticResource SmallMarginBottom}">
                                        <ContentPresenter Margin="{StaticResource ExtraSmallMarginAll}"
                                                          Content="{Binding}"
                                                          ContentTemplateSelector="{StaticResource StyledButtonTemplateSelector}"
                                                          DockPanel.Dock="Left">
                                            <ContentPresenter.Resources>
                                                <DataTemplate x:Key="IssuablePresenter" DataType="{x:Type hudModelTypes:UIInfoModel}">
                                                    <Grid Width="{StaticResource HUDTooltipSmallIconSize}" Height="{StaticResource HUDTooltipSmallIconSize}">
                                                        <Border Name="Bg" Background="{DynamicResource ButtonBgBrush}">
                                                            <Border Background="{DynamicResource ButtonBgHighlightBrush}" />
                                                        </Border>

                                                        <Image Source="{Binding Icon}" />

                                                        <Border BorderBrush="{DynamicResource PrimaryColorLightBrush}"
                                                                BorderThickness="1"
                                                                Visibility="{Binding IsUniqueToRace, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                            <Image Width="15" Height="15"
                                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                   Source="pack://application:,,,/WPFGUI;component/icons/unique.png" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>

                                        <DockPanel Margin="{StaticResource SmallMarginLeft}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                                   DockPanel.Dock="Right">
                                            <esControls:Marquee HorizontalAlignment="Left"
                                                                DockPanel.Dock="Top" MarqueeType="ScrollToLeft"
                                                                Speed="60">
                                                <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding Name}" />
                                            </esControls:Marquee>
                                            <esControls:Marquee HorizontalAlignment="Left"
                                                                DockPanel.Dock="Bottom" MarqueeType="ScrollToLeft"
                                                                Speed="60">
                                                <TextBlock Style="{StaticResource nHUDSubtitleTextBlockStyle}" Text="{Binding Extra}" />
                                            </esControls:Marquee>
                                        </DockPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="MaxWidth" Value="{StaticResource HUDIssuableTooltipMaxWidth}" />
    </Style>

    <models:DataTemplateSourceSelector x:Key="ToolTipTemplateSelector"
                                       DataTemplatePropertyName="TooltipDataTemplate" Optional="True">
        <models:DataTemplateSourceSelector.DefaultDataTemplate>
            <DataTemplate DataType="{x:Type hudModelTypes:IssuableModel}">
                <ContentControl Content="{Binding}" Style="{StaticResource DefaultIssuableTooltipDataTemplate}" />
            </DataTemplate>
        </models:DataTemplateSourceSelector.DefaultDataTemplate>
    </models:DataTemplateSourceSelector>

    <DataTemplate x:Key="UniqueBuildingUpgradeDataTemplate" DataType="{x:Type local:IssuableButton}">
        <ContentControl Content="{Binding}" Style="{StaticResource DefaultIssuableTooltipDataTemplate}" />
    </DataTemplate>

    <DataTemplate x:Key="BuyResourceDataTemplate" DataType="{x:Type gameStatsModelTypes:PlayerResourceModel}">
        <StackPanel Orientation="Vertical">
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource nHUDBodyTextBlockStyle}"
                       TextWrapping="Wrap">
                <TextBlock.Text>
                    <!--  $11164353: Spend %1AMOUNT:.0% Gold to get %2AMOUNT:0%  %3RESOURCE_TYPE%  -->
                    <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11164353">
                        <Binding Path="BuyRate" />
                        <Binding Path="BuyAmount" />
                        <Binding Path="Name" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <StackPanel Margin="{StaticResource SmallMarginTop}" Orientation="Horizontal">
                <Image Width="{StaticResource HUDResourceIconSize}"
                       Height="{StaticResource HUDResourceIconSize}"
                       VerticalAlignment="Center"
                       Source="../../icons/resources/resource_gold_icon.png" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource nHUDBaseTextBlockStyle}"
                           Text="{Binding BuyRate, Mode=OneWay, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11168429}"
                           TextAlignment="Center" />
                <Image Style="{StaticResource TooltipArrowRightImage}" />
                <Image Width="{StaticResource HUDResourceIconSize}"
                       Height="{StaticResource HUDResourceIconSize}"
                       VerticalAlignment="Center"
                       Source="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource nHUDBaseTextBlockStyle}"
                           Text="{Binding BuyAmount, Mode=OneWay, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11168430}"
                           TextAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="SellResourceDataTemplate" DataType="{x:Type gameStatsModelTypes:ResourceModel}">
        <StackPanel Orientation="Vertical">
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource nHUDBodyTextBlockStyle}"
                       TextWrapping="Wrap">
                <TextBlock.Text>
                    <!--  $11164354: Sell %1AMOUNT:.0% %2RESOURCE_TYPE% to get %3AMOUNT:.0% Gold  -->
                    <MultiBinding Converter="{StaticResource LocalizedStringMultiConverter}" ConverterParameter="$11164354">
                        <Binding Path="SellAmount" />
                        <Binding Path="Name" />
                        <Binding Path="SellRate" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <StackPanel Margin="{StaticResource SmallMarginTop}" Orientation="Horizontal">
                <Image Width="{StaticResource HUDResourceIconSize}"
                       Height="{StaticResource HUDResourceIconSize}"
                       VerticalAlignment="Center"
                       Source="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource nHUDBaseTextBlockStyle}"
                           Text="{Binding SellAmount, Mode=OneWay, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11168429}"
                           TextAlignment="Center" />
                <Image Style="{StaticResource TooltipArrowRightImage}" />
                <Image Width="{StaticResource HUDResourceIconSize}"
                       Height="{StaticResource HUDResourceIconSize}"
                       VerticalAlignment="Center"
                       Source="../../icons/resources/resource_gold_icon.png" />
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource nHUDBaseTextBlockStyle}"
                           Text="{Binding SellRate, Mode=OneWay, Converter={StaticResource LocalizedStringConverter}, ConverterParameter=$11168430}"
                           TextAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!--
        StyledButtonTemplateSelector for setting dynamic resource ButtonBgBrush doesn't work for the buy and sell tooltip templates.
        The dynamic resources "IssuablePresenter" referencing inside that selector causes a infinite recursion.
        Probably because there is already a "IssuablePresenter" in the button which creates the tooltip.
        However, the recursion only happens for the templates that's in the resources but not for the default one.
        Set ButtonBgBrush explicitly to bypass the issue.
    -->
    <DataTemplate x:Key="BuySellTooltipLabelPresenter" DataType="{x:Type hudModelTypes:IssuableModel}">
        <StackPanel>
            <StackPanel.Resources>
                <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ButtonBgAbilityColor}" />
            </StackPanel.Resources>

            <Grid HorizontalAlignment="Left" Visibility="{Binding Properties.UIInfo.Extra, Converter={StaticResource NotNullOrEmptyStringToVis}}">
                <Border Background="{DynamicResource ButtonBgBrush}" />
                <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                    <TextBlock Style="{StaticResource nHUDSubtitleTextBlockStyle}" Text="{Binding Properties.UIInfo.Extra}" />
                </esControls:Marquee>
            </Grid>

            <Border HorizontalAlignment="Left" Visibility="{Binding Properties.UIInfo.Extra, Converter={StaticResource NullOrEmptyStringToVis}}">
                <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                    <TextBlock Style="{StaticResource HUDActivationTypeTextBlockStye}" />
                </esControls:Marquee>
            </Border>
        </StackPanel>
    </DataTemplate>

    <Style BasedOn="{StaticResource FlowControl}" TargetType="{x:Type local:IssuableToolTip}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:IssuableToolTip}">
                    <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource ToolTipTemplateSelector}">
                        <ContentPresenter.Resources>
                            <SolidColorBrush x:Key="ButtonBgBrush" Color="{StaticResource ButtonBgAbilityColor}" />
                            <RadialGradientBrush x:Key="ButtonBgHighlightBrush" Center="0.5,0" GradientOrigin="0.5,0" GradientStops="{StaticResource ButtonBgLightAbilityColor}" RadiusX="0.7" RadiusY="0.6" />
                            <DataTemplate x:Key="FoodPurchaseTooltipDataTemplate" DataType="{x:Type hudModelTypes:IssuableModel}">
                                <ContentControl Style="{StaticResource HUDTooltipBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              Width="{StaticResource HUDTooltipIconSize}"
                                              Height="{StaticResource HUDTooltipIconSize}"
                                              VerticalAlignment="Top">
                                            <!--<Rectangle Style="{StaticResource DefaultTooltipIconBackground}" />-->
                                            <Border Background="{DynamicResource ButtonBgBrush}">
                                                <Border Background="{DynamicResource ButtonBgHighlightBrush}" />
                                            </Border>
                                            <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/market_buy_food.png" />
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Vertical">
                                            <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding Properties.UIInfo.Name}" />
                                            </esControls:Marquee>
                                            <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BuySellTooltipLabelPresenter}" />
                                            </esControls:Marquee>
                                            <ContentPresenter Margin="{StaticResource SmallMarginTop}"
                                                              VerticalAlignment="Top"
                                                              Content="{Binding Player.Resources[0]}"
                                                              ContentTemplate="{StaticResource BuyResourceDataTemplate}" />
                                        </StackPanel>
                                    </Grid>

                                </ContentControl>
                            </DataTemplate>
                            <DataTemplate x:Key="FoodSellTooltipDataTemplate" DataType="{x:Type hudModelTypes:IssuableModel}">
                                <ContentControl Style="{StaticResource HUDTooltipBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              Width="{StaticResource HUDTooltipIconSize}"
                                              Height="{StaticResource HUDTooltipIconSize}"
                                              VerticalAlignment="Top">
                                            <!--<Rectangle Style="{StaticResource DefaultTooltipIconBackground}" />-->
                                            <Border Background="{DynamicResource ButtonBgBrush}">
                                                <Border Background="{DynamicResource ButtonBgHighlightBrush}" />
                                            </Border>
                                            <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/market_sell_food.png" />
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Vertical">
                                            <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding Properties.UIInfo.Name}" />
                                            </esControls:Marquee>
                                            <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BuySellTooltipLabelPresenter}" />
                                            </esControls:Marquee>
                                            <ContentPresenter Margin="{StaticResource SmallMarginTop}"
                                                              Content="{Binding Player.Resources[0]}"
                                                              ContentTemplate="{StaticResource SellResourceDataTemplate}" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                            <DataTemplate x:Key="WoodPurchaseTooltipDataTemplate" DataType="{x:Type hudModelTypes:IssuableModel}">
                                <ContentControl Style="{StaticResource HUDTooltipBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              Width="{StaticResource HUDTooltipIconSize}"
                                              Height="{StaticResource HUDTooltipIconSize}"
                                              VerticalAlignment="Top">
                                            <!--<Rectangle Style="{StaticResource DefaultTooltipIconBackground}" />-->
                                            <Border Background="{DynamicResource ButtonBgBrush}">
                                                <Border Background="{DynamicResource ButtonBgHighlightBrush}" />
                                            </Border>
                                            <Image Source="pack://application:,,,/WPFGUI;component/icons/races/common/abilities/market_buy_wood.png" />
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Vertical">
                                            <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding Properties.UIInfo.Name}" />
                                            </esControls:Marquee>
                                            <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource BuySellTooltipLabelPresenter}" />
                                            </esControls:Marquee>
                                            <ContentPresenter Margin="{StaticResource SmallMarginTop}"
                                                              Content="{Binding Player.Resources[1]}"
                                                              ContentTemplate="{StaticResource BuyResourceDataTemplate}" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                            <DataTemplate x:Key="WoodSellTooltipDataTemplate" DataType="{x:Type hudModelTypes:IssuableModel}">
                                <ContentControl Style="{StaticResource HUDTooltipBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0"
                                              Width="{StaticResource HUDTooltipIconSize}"
                                              Height="{StaticResource HUDTooltipIconSize}"
                                              VerticalAlignment="Top">
                                            <!--<Rectangle Style="{StaticResource DefaultTooltipIconBackground}" />-->
                                            <Border Background="{DynamicResource ButtonBgBrush}">
