                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>

                            <!--  This is unused for launch. It appears when mousing over in-progress landmarks at the top of the HUD ie. Age Progress Widget  -->
                            <!--  However to prevent stealing mouse clicks, this feature has been disabled (hittestvisible = false)  -->
                            <!--  These styles will likely be out of date if anyone ever resurrects this functionality  -->
                            <DataTemplate x:Key="WondersDataTemplate" DataType="{x:Type hudModelTypes:IssuableModel}">
                                <ContentControl MaxWidth="{StaticResource HUDTooltipMaxWidthSmall}" Style="{StaticResource HUDTooltipBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="{StaticResource HUDTooltipGutterWidthGridLength}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                                            <!--  command card icon  -->
                                            <Grid Width="{StaticResource HUDTooltipIconSize}"
                                                  Height="{StaticResource HUDTooltipIconSize}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Image Name="IconImage"
                                                       Source="{Binding Properties.UIInfo.Icon}"
                                                       Style="{StaticResource ButtonIconStyle}" />
                                            </Grid>

                                            <!--  resources  -->
                                            <ItemsControl Margin="0,8,0,0" VerticalAlignment="Top"
                                                          ItemsSource="{Binding DataContext.SelectionPlayer.NextAge.Resources, RelativeSource={RelativeSource AncestorType={x:Type eHUDPages:HUDPage}}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Vertical" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="26" Height="20"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Stretch="Uniform">
                                                                <Image.Style>
                                                                    <Style BasedOn="{StaticResource {x:Type Image}}" TargetType="{x:Type Image}">
                                                                        <Setter Property="Source" Value="{Binding Icon}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInsufficient}" Value="True">
                                                                                <Setter Property="Source" Value="{Binding InsufficientIcon}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center"
                                                                       Text="{Binding Amount, Converter={StaticResource CastToIntOperator}}">
                                                                <TextBlock.Style>
                                                                    <Style BasedOn="{StaticResource nHUDBaseHeavyTextBlockStyle}" TargetType="{x:Type TextBlock}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInsufficient}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ErrorColorLightBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Margin="3,12,0,0"
                                                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type eHUDPages:HUDPage}}}"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding SelectionPlayer.NextAge.ProductionTimeTotal, Converter={StaticResource InequalityCompare}, ConverterParameter=0}">
                                                <Image Width="20" Height="20"
                                                       VerticalAlignment="Center"
                                                       Source="/WPFGUI;component/icons/shared/elapsed_time_icon.png" />
                                                <!--  ProductionTimeTotal  -->
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                           Text="{Binding SelectionPlayer.NextAge.ProductionTimeTotal, Converter={StaticResource TimeFormat}}"
                                                           Visibility="{Binding SelectionPlayer.NextAge.ProductionTimeTotal, Converter={StaticResource NumberToVis}}" />
                                                <!--  infinity symbol: visible if ProductionTimeTotal < 0  -->
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                           Text="{esUtility:LocString $11168149}"
                                                           Visibility="{Binding SelectionPlayer.NextAge.ProductionTimeTotal, Converter={StaticResource LessCompare}, ConverterParameter=0}" />
                                            </StackPanel>

                                            <!--  Population Cost  -->
                                            <Grid Margin="3,12,0,0" Visibility="{Binding Population.Population, Converter={StaticResource GreaterCompare}, ConverterParameter=1, FallbackValue=Collapsed}">
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSufficientPopulation, Converter={StaticResource BoolToVis}}">
                                                    <Image Width="20" Height="23"
                                                           VerticalAlignment="Center"
                                                           Source="/WPFGUI;component/icons/resources/resource_popcap.png" />
                                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                               Text="{Binding Population.Population, Converter={StaticResource CastToIntOperator}}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasSufficientPopulation, Converter={StaticResource InvBoolToVis}}">
                                                    <Image Height="{StaticResource HUDResourceIconSize}"
                                                           VerticalAlignment="Center"
                                                           Source="/WPFGUI;component/icons/resources/resource_popcap_reached.png" />
                                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Style="{StaticResource nHUDBaseHeavyErrorTextBlockStyle}"
                                                               Text="{Binding Population.Population, Converter={StaticResource CastToIntOperator}}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Margin="3,12,0,0"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding RechargingVisibility, FallbackValue=Collapsed}">
                                                <Image Width="20" Height="20"
                                                       VerticalAlignment="Center"
                                                       Source="/WPFGUI;component/icons/shared/elapsed_time_icon.png" />
                                                <TextBlock Margin="6,4,0,0" VerticalAlignment="Center"
                                                           Style="{StaticResource nHUDBaseHeavyTextBlockStyle}"
                                                           Text="{Binding RechargeSecondsRemaining}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Vertical">
                                            <StackPanel>
                                                <!--  title text  -->
                                                <esControls:Marquee MarqueeType="ScrollToLeft" Speed="60">
                                                    <TextBlock Style="{StaticResource nHUDTitleTextBlockStyle}" Text="{Binding Properties.UIInfo.Name}" />
                                                </esControls:Marquee>

                                                <!--  Description  -->
                                                <TextBlock Margin="{StaticResource SmallMarginTop}"
                                                           Style="{StaticResource nHUDBodyTextBlockStyle}"
                                                           Text="{Binding Properties.UIInfo.Help}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                        </ContentPresenter.Resources>
                    </ContentPresenter>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
