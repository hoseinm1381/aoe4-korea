function GarrisonCivResources_748d61b94d3e4cf3a506a9ac1f992d1d_OnGameSetup()
    requested, preparing = false, false
end
local function required()
    if type(PLAYERS) ~= "table" or #PLAYERS == 0 then
        print("GARRISON_CIV_PRECACHE fallback=own_roster race=" .. resourceRace)
        return true
    end
    for _, player in ipairs(PLAYERS) do
        if Player_GetRaceName(player.id) == resourceRace then return true end
    end
    return false
end
function GarrisonCivResources_748d61b94d3e4cf3a506a9ac1f992d1d_Precache()
    if requested then return end
    assert(not preparing, "Recursive civilization precache")
    if not required() then requested = true; return end
    preparing = true
    local ok, failure = pcall(function()
        local resources = {}
        for _, name in ipairs(entities) do
            assert(EBP_Exists(name), "Missing civilization EBP: " .. name)
            local bp = BP_GetEntityBlueprint(name)
            assert(bp ~= nil, "Unresolved civilization EBP: " .. name)
            resources[#resources + 1] = bp
        end
        for _, name in ipairs(squads) do
            assert(SBP_Exists(name), "Missing civilization SBP: " .. name)
            local bp = BP_GetSquadBlueprint(name)
            assert(bp ~= nil, "Unresolved civilization SBP: " .. name)
            resources[#resources + 1] = bp
        end
        for _, bp in ipairs(resources) do Scar_PrecachePrematchResource(bp) end
    end)
    preparing = false
    if not ok then error(failure) end
    requested = true
    print("GARRISON_CIV_PREMATCH_REQUESTED race=" .. resourceRace
        .. " entities=" .. tostring(#entities) .. " squads=" .. tostring(#squads))
end
Scar_AddInit(GarrisonCivResources_748d61b94d3e4cf3a506a9ac1f992d1d_Precache)

import("cardinal.scar")
Core_RegisterModule("KoreaIndependent")
import("korea/catalog.scar")
import("korea/core.scar")
import("korea/blueprints.scar")
import("korea/initialization.scar")
import("korea/research_core.scar")
import("korea/research.scar")
import("korea/effect_catalog.scar")
import("korea/effects.scar")
import("korea/economy.scar")
import("korea/landmarks.scar")
import("korea/ui.scar")
import("korea/lifecycle.scar")
import("korea/voices_020.scar")

KoreaIndependentState={started=false,active=false,ending=false,civilizations={},selection={closed=true}}
local state=KoreaIndependentState
local function startLocalVoices()
    if not KoreaVoice_Start then return end
    local player=Game_GetLocalPlayer()
    if next(state.civilizations)~=nil or (player~=nil and Player_GetRaceName(player)=="748d61b94d3e4cf3a506a9ac1f992d1d:korea") then
        KoreaVoice_Start(state.civilizations)
    end
end
function KoreaIndependent_OnGameSetup()
    state.started=false;state.active=false;state.ending=false;state.civilizations={};state.selection={closed=true}
    KoreaInitializationState.applied={}
    KoreaState.ending=false
end
function KoreaIndependent_OnInit()
    -- Standard remains the owner of victory conditions and starting armies.
end
function KoreaIndependent_Start()
    if state.started or state.ending then return end
    state.started=true
    for _,player in ipairs(PLAYERS) do
        if player.isHuman and Player_GetRaceName(player.id)=="748d61b94d3e4cf3a506a9ac1f992d1d:korea" then
            local accepted,reason=KoreaInitialization_Apply(player)
            if accepted then state.civilizations[player.index]="korea"
            else print("KOREA_INDEPENDENT_START_REJECT "..tostring(reason)) end
        end
    end
    -- Voice presentation follows the selected local race, independently of the gameplay start guard.
    startLocalVoices()
    if next(state.civilizations)==nil then return end
    state.active=true
    KoreaLifecycle_Start(state.civilizations)
end

function KoreaIndependent_OnGameRestore()
    if not state.started or state.ending then return end
    -- Retained restore hooks do not establish save/load acceptance.
    if KoreaVoice_Stop then KoreaVoice_Stop() end
    startLocalVoices()
end
function KoreaIndependent_OnGameOver()
    if state.ending then return end
    state.ending=true
    if KoreaVoice_Stop then KoreaVoice_Stop() end
    if state.active then
    KoreaLifecycle_Cleanup()
    end
    state.active=false
    state.started=false
    state.civilizations={}
    KoreaInitializationState.applied={}
end
